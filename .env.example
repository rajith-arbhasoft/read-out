# Example only.
# Replace values manually on the server.
# Do not commit this file with real credentials.
#
# Copy to .env.local for local development, or set these in the process
# environment used by `npm start`. Restart Next.js after any change.
#
# Each DATABASE_<NAME> variable becomes an environment in the UI.
# The browser receives the name only (DEV, QAS, PROD, ...), never the URL.

DATABASE_DEV=postgresql://sql_tool_reader:password@10.10.10.10:5432/application_dev
DATABASE_QAS=postgresql://sql_tool_reader:password@10.10.20.10:5432/application_qas
DATABASE_PROD=postgresql://sql_tool_reader:password@10.10.30.10:5432/application_prod

# Add another environment without changing application code:
# DATABASE_UAT=postgresql://sql_tool_reader:password@10.10.40.10:5432/application_uat
# DATABASE_STAGING=postgresql://sql_tool_reader:password@10.10.50.10:5432/application_staging
#
# After restart, the new name appears in the environment selector.

# --- Optional limits (defaults shown) --- 
#
# Connection pool size. PROD defaults to 1, DEV to 3, QAS to 2, others to 2.
# Override one environment:
# SQL_TOOL_POOL_MAX_PROD=1
# SQL_TOOL_POOL_MAX_DEV=3
# SQL_TOOL_POOL_MAX_QAS=2
# SQL_TOOL_POOL_MAX=2
#
# Query timeout in milliseconds. PROD defaults to 15000, DEV to 30000, QAS to 20000.
# SQL_TOOL_TIMEOUT_MS_PROD=15000
# SQL_TOOL_TIMEOUT_MS_DEV=30000
# SQL_TOOL_TIMEOUT_MS_QAS=20000
# SQL_TOOL_TIMEOUT_MS=20000
#
# How long to wait for a free pool connection before returning a busy error.
# SQL_TOOL_CONNECTION_TIMEOUT_MS=4000
#
# SQL_TOOL_MAX_ROWS=10000
# SQL_TOOL_MAX_RESPONSE_BYTES=5000000
# SQL_TOOL_MAX_QUERY_CHARS=100000
#
# Environments that require an execute confirmation and show a production warning.
# Names are matched case-insensitively. Default: PROD
# SQL_TOOL_CONFIRM_ENVIRONMENTS=PROD
#
# Where saved queries and history are stored. This is the tool's own database.
# It is not one of the application PostgreSQL databases.
# SQL_TOOL_DATA_DIR=./data
